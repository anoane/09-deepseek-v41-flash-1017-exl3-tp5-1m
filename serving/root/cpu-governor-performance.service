[Unit]
Description=Hold every core at the performance clock governor (the owner decided this on 2026-10-11)
After=multi-user.target power-profiles-daemon.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c "echo performance | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor > /dev/null"

[Install]
WantedBy=multi-user.target
